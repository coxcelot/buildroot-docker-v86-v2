# ============================================================
# Buildroot config FRAGMENT: Docker inside a v86 browser VM
# ============================================================
# TARGET: buildroot 2024.02.5 + browser-buildroot "standard" config
#   https://github.com/Darin755/browser-buildroot  (README: 2024.02.5, kernel 6.6)
#   The standard config already provides the REQUIRED prerequisites:
#     - BR2_TOOLCHAIN_USES_GLIBC=y      (docker-engine/containerd/runc need glibc/musl)
#     - kernel headers >= 5.2           (needed by docker-engine)
#     - BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS=y (x86 supported)
#     - Go/CGO toolchain support        (BR2_PACKAGE_HOST_GO_TARGET_CGO_...)
#
# VERIFIED against buildroot 2024.02.5 package/ Config.in files:
#   docker-engine selects: cgroupfs-mount, containerd, iptables, libseccomp
#   containerd   selects: runc (if !crun), util-linux + binaries/mount/pivot_root/mountpoint
#   ...so you do NOT need to list those — but listing the main ones is harmless.
#   NOTE: 2024.02.5 has NO cgroupfs-v2 package and NO docker-init (tini) option.

# ---- The packages you requested ----
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBSECCOMP=y
BR2_PACKAGE_CONTAINERD=y
BR2_PACKAGE_RUNC=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_ENGINE=y

# ---- v86: single-file boot. Embed the rootfs inside the kernel image. ----
BR2_TARGET_ROOTFS_INITRAMFS=y
# (initramfs auto-selects BR2_TARGET_ROOTFS_CPIO; kernel compression is used)

# ---- Runtime deps auto-selected by docker-engine/containerd (for reference) ----
# BR2_PACKAGE_CGROUPFS_MOUNT=y     (auto-selected, cgroup v1 scripts)
# BR2_PACKAGE_IPTABLES=y           (auto-selected)
# BR2_PACKAGE_UTIL_LINUX=y         (auto-selected by containerd)
# BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# BR2_PACKAGE_UTIL_LINUX_PIVOT_ROOT=y
# BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
# BR2_PACKAGE_UTIL_LINUX_MOUNT=y

# ---- Kernel features Docker/runc NEED inside the guest ----
# browser-buildroot's board/browser_linux/linux.conf already has:
#   CONFIG_CGROUPS=y CONFIG_NET=y CONFIG_PACKET=y CONFIG_UNIX=y CONFIG_INET=y
#   CONFIG_VIRTIO_NET=y CONFIG_TMPFS=y ...
# Add these (docker-kernel.config):
#   CONFIG_NAMESPACES=y CONFIG_UTS_NS=y CONFIG_IPC_NS=y CONFIG_PID_NS=y
#   CONFIG_NET_NS=y CONFIG_USER_NS=y
#   CONFIG_CGROUP_* / CONFIG_MEMCG=y / CONFIG_BLK_CGROUP=y
#   CONFIG_VETH=y CONFIG_OVERLAY_FS=y
#   CONFIG_NETFILTER=y CONFIG_IP_NF_IPTABLES=y CONFIG_IP_NF_NAT=y
#   CONFIG_NF_NAT=y CONFIG_NF_CONNTRACK=y
#   CONFIG_POSIX_MQUEUE=y CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# ---- Runtime notes (in the guest, after boot) ----
#   S99docker in the rootfs overlay starts containerd + dockerd (vfs driver)
#   docker run --rm busybox  # small test
